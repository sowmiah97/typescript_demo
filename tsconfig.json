{
    "compilerOptions": {
        "target": "ES6",                     // Target ECMAScript version
        "module": "commonjs",                 // Use CommonJS module system
        "outDir": "./dist",                   // Output directory for compiled files
        "rootDir": "./src",                   // Root directory of input files                  // Enable all strict type checking options            // Enable compatibility with CommonJS modules
        "skipLibCheck": true,
        "noImplicitAny": true, // This is to specify compiler not to fallback to any type in case type cannot be filtered
        "removeComments": false, // To remove comment from a ts file when its compiled to js file
        "preserveConstEnums": true,
        "sourceMap": false, // Generate a .map file
        "strict": true, // On/off strictness using this param. Recommended to be on
        "strictNullChecks": true, // Enables to explicitly add null checks in our code,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
    },
    "include": ["src/**/*"]
}